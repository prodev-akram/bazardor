# MongoDB connection string (MongoDB Atlas free tier works fine; Vercel has no persistent disk)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/bazardor

# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Local: http://localhost:3000   |   Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social login (callback URL: {BETTER_AUTH_URL}/api/auth/callback/google  and  /github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
